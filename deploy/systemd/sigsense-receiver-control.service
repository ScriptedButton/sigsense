[Unit]
Description=SigSense receiver control broker
After=network.target

[Service]
WorkingDirectory=/home/cole/sigsense/apps/web
Environment=PATH=/home/cole/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/cole/.local/bin/pnpm exec tsx server/receiver-control/broker.ts
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
