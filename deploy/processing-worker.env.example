# Install as a private environment file on the GPU machine (mode 0600).
# Generate one shared secret: python -c 'import secrets; print(secrets.token_urlsafe(32))'
SIGSENSE_PROCESSING_TOKEN=REPLACE_WITH_THE_SAME_RANDOM_SECRET_ON_BOTH_MACHINES
SIGSENSE_PROCESSING_DEVICE=cuda:0
SIGSENSE_PROCESSING_MODEL=demucs-dns64
SIGSENSE_PROCESSING_MAX_STREAMS=2
