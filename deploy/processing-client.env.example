# Install as /etc/sigsense/processing-client.env on the receiver host (mode 0600).
# Use the GPU machine's actual LAN address; never the receiver's browser address.
SIGSENSE_PROCESSING_URL=http://192.168.1.50:8791
SIGSENSE_PROCESSING_TOKEN=REPLACE_WITH_THE_SAME_RANDOM_SECRET_ON_BOTH_MACHINES
SIGSENSE_PROCESSING_DEADLINE_MS=90
